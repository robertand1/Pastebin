<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h4 class="card-title text-center mb-3">Add a new text</h4>
        <form action="/add" method="POST">
            <textarea name="content" class="form-control mb-3" rows="5" placeholder="Write your text here..." required></textarea>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">Save Text</button>
            </div>
        </form>
    </div>
</div>

<% if (texts.length > 0) { %>
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="card-title text-center mb-3">Saved Texts</h4>
            <ul class="list-group list-group-flush">
                <% texts.forEach(function(text) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                        <span>
                            <%= text.content.length > 30 ? text.content.substring(0, 30) + '...' : text.content %>
                        </span>
                        <a href="/text/<%= text.id %>" class="btn btn-outline-primary btn-sm ms-2" style="white-space: nowrap;">View full</a>
                    </li>
                <% }); %>
            </ul>
        </div>
    </div>
<% } %>
