<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Pastebin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <br><br><br>
    <center>   
        <h2>Add a new text</h2>
        <form action="/add" method="POST">
            <textarea name="content" rows="6" cols="50" placeholder="Write your text here..." required></textarea>
            <br><br>
            <button type="submit" class="btn btn-primary">Save Text</button>
        </form>
        <br><br>
        <% if (texts.length > 0) { %>
            <h2>Saved Texts</h2>
            <div style="width: 50%; text-align: left;">
                <ul>
                    <% texts.forEach(function(text) { %>
                        <li style="margin-bottom: 10px;">
                            <%= text.content.length > 30 ? text.content.substring(0, 30) + '...' : text.content %>
                            <a href="/text/<%= text.id %>" class="btn btn-outline-primary btn-sm" style="float: right;">View full</a>
                        </li>
                    <% }); %>
                </ul>
            </div>
        <% } %>
    </center>
</body>
</html>