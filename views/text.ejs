<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>View Text</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body>
    <br /><br /><br />
    <center>
      <h2>Full text</h2>
      <div
        style="
          width: 50%;
          text-align: left;
          background-color: #f9f9f9;
          padding: 20px;
          border: 1px solid #ccc;
          white-space: pre-wrap;
        "
      >
        <%= text.content %>
      </div>
      <br /><br />
      <a href="/" class="btn btn-secondary">&larr; Back to list</a>
    </center>
  </body>
</html>
